<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Vtiger Batch Suite">
    <test name="Batch Tests">
        <groups>
            <run>
                <include name="Smoke"/>
                <include name="Functional"/>
                <include name="Negative"/>
                <include name="BVA"/>
                <include name="System"/>
                <include name="Integration"/>

            </run>
        </groups>

        <classes>

            <!-- Leads -->
            <class name="leads.LeadsSmokeTest"/>
            <class name="leads.LeadsFunctionalTest"/>
            <class name="leads.LeadsNegativeTest"/>
            <class name="leads.LeadsBVATest"/>
            <class name="leads.LeadsSystemTest"/>
            <class name="leads.LeadsIntegrationTest"/>

            <!-- Campaign -->
            <class name="Campaign.CampaignSmokeTest"/>
            <class name="Campaign.CampaignFunctionalTest"/>
            <class name="Campaign.CampaignNegativeTest"/>
            <class name="Campaign.CampaignBVATest"/>
            <class name="Campaign.CampaignSystemTest"/>
            <class name="Campaign.CampaignIntegrationTest"/>

            <!-- Trouble Tickets -->
            <class name="TroubleTickets.TroubleTicketsSmokeTest"/>
            <class name="TroubleTickets.TroubleTicketsFunctionalTest"/>
            <class name="TroubleTickets.TroubleTicketsNegativeTest"/>
            <class name="TroubleTickets.TroubleTicketsBVATest"/>
            <class name="TroubleTickets.TroubleTicketsSystemTest"/>
            <class name="TroubleTickets.TroubleTicketsIntegrationTest"/>

            <!-- Dashboard -->
            <class name="dashboard.DashboardSmokeTest"/>
            <class name="dashboard.DashboardFunctionalTest"/>
            <class name="dashboard.DashboardNegativeTest"/>
            <class name="dashboard.DashboardBVATest"/>
            <class name="dashboard.DashboardSystemTest"/>
            <class name="dashboard.DashboardIntegrationTest"/>

        </classes>

    </test>

</suite>