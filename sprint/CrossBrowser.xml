<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Cross Browser Suite" parallel="tests" thread-count="3">

    <test name="Chrome">
        <parameter name="browser" value="chrome"/>

        <classes>
            <class name="Login.LoginBVATest"/>
            <class name="Product.ProductBVATest"/>
            <class name="AddCart.PurchaseBVATest"/>
            <class name="ContactCommunity.ContactCommunityBVATest"/>
        </classes>

    </test>

    <test name="Firefox">
        <parameter name="browser" value="firefox"/>

        <classes>
            <class name="Login.LoginBVATest"/>
            <class name="Product.ProductBVATest"/>
            <class name="AddCart.PurchaseBVATest"/>
            <class name="ContactCommunity.ContactCommunityBVATest"/>
        </classes>

    </test>

    <test name="Edge">
        <parameter name="browser" value="edge"/>

        <classes>
            <class name="Login.LoginBVATest"/>
            <class name="Product.ProductBVATest"/>
            <class name="AddCart.PurchaseBVATest"/>
            <class name="ContactCommunity.ContactCommunityBVATest"/>
        </classes>

    </test>

</suite>